{
  "name": "gridiron-legends",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Original pixel-art arcade American football game with deep franchise simulation",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:size": "node scripts/check-file-sizes.mjs",
    "check": "npm run typecheck && npm run lint:size && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
